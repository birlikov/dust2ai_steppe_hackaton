---
/**
 * Cashier hero — store-front chat at the top of the homepage.
 *
 * Visual framing: you're talking to the HappyCake cashier, not a chatbot.
 * Hero photo backdrop with happy-blue-900 overlay, Cormorant headline, a
 * cream chat panel below with suggested-prompt chips, an input row, and a
 * scrollable transcript.
 *
 * Posts to `${API_BASE}/api/chat` (same origin in the one-port ngrok demo).
 * Persists the session id in localStorage so a returning visitor keeps the
 * conversation context.
 *
 * Behavior lives in `/public/cashier-chat.js` (kept as a separate file so
 * the .astro template stays under the project's 500-LOC ceiling). The
 * build-time API base is forwarded to that script via a hidden config
 * element below; this replaces the previous `define:vars` pattern, which
 * required Astro's bundler.
 */
const apiBase = import.meta.env.PUBLIC_API_BASE ?? "";
---

<section class="cashier-hero">
  <img
    class="cashier-hero__bg"
    src="/brand/hero/happy-cake-hero-01.webp"
    alt=""
    aria-hidden="true"
    loading="eager"
  />
  <div class="cashier-hero__overlay" aria-hidden="true"></div>

  <div class="cashier-hero__inner">
    <p class="cashier-hero__eyebrow">◆ HappyCake · Sugar Land, TX</p>
    <h1 class="cashier-hero__headline">Tell our cashier what you'd like.</h1>
    <p class="cashier-hero__subhead">
      Real cakes, hand-decorated in our kitchen this morning. Ask anything &mdash;
      what's fresh today, what fits ten guests, custom for Saturday.
    </p>

    <!-- Cashier illustration. data-state swaps colour + caption. -->
    <div class="cashier-figure" id="cashier-figure" data-state="idle" aria-hidden="true">
      <svg viewBox="0 0 120 120" width="80" height="80" xmlns="http://www.w3.org/2000/svg">
        <!-- counter -->
        <rect x="10" y="92" width="100" height="20" fill="#1B4868" />
        <rect x="10" y="88" width="100" height="6" fill="#0E2A3C" />
        <!-- cashier body -->
        <ellipse cx="60" cy="92" rx="22" ry="6" fill="#3B7BA8" opacity="0.4" />
        <circle cx="60" cy="55" r="18" fill="#FBF6E8" stroke="#0E2A3C" stroke-width="1.5" />
        <!-- apron -->
        <path d="M40 92 Q40 70 60 70 Q80 70 80 92 Z" fill="#BFD8E8" stroke="#0E2A3C" stroke-width="1.5" />
        <!-- cap -->
        <path d="M44 42 Q60 28 76 42 L76 50 L44 50 Z" fill="#FBF6E8" stroke="#0E2A3C" stroke-width="1.5" />
        <!-- eyes (state-specific via CSS) -->
        <circle class="cashier-eye" cx="55" cy="55" r="1.5" fill="#0E2A3C" />
        <circle class="cashier-eye" cx="65" cy="55" r="1.5" fill="#0E2A3C" />
        <!-- mouth (state-specific via CSS) -->
        <path class="cashier-mouth" d="M55 62 Q60 65 65 62" stroke="#0E2A3C" stroke-width="1.5" fill="none" stroke-linecap="round" />
        <!-- thinking dots (only rendered in thinking state) -->
        <g class="cashier-think">
          <circle cx="86" cy="38" r="1.6" fill="#0E2A3C">
            <animate attributeName="opacity" values="0.2;1;0.2" dur="1s" begin="0s" repeatCount="indefinite" />
          </circle>
          <circle cx="92" cy="34" r="1.6" fill="#0E2A3C">
            <animate attributeName="opacity" values="0.2;1;0.2" dur="1s" begin="0.2s" repeatCount="indefinite" />
          </circle>
          <circle cx="98" cy="30" r="1.6" fill="#0E2A3C">
            <animate attributeName="opacity" values="0.2;1;0.2" dur="1s" begin="0.4s" repeatCount="indefinite" />
          </circle>
        </g>
      </svg>
      <span class="cashier-caption" id="cashier-caption">listening</span>
    </div>

    <div class="cashier-card" id="cashier-card" role="region" aria-label="Talk to the HappyCake cashier">
      <div class="cashier-card__transcript" id="cashier-transcript" aria-live="polite" aria-atomic="false"></div>

      <div class="cashier-card__chips" id="cashier-chips" role="list">
        <button class="cashier-chip" type="button" data-prompt="What's fresh today?" role="listitem">What's fresh today?</button>
        <button class="cashier-chip" type="button" data-prompt="I need a cake for ten guests" role="listitem">Cake for ten guests</button>
        <button class="cashier-chip" type="button" data-prompt="Custom cake for Saturday" role="listitem">Custom for Saturday</button>
        <button class="cashier-chip" type="button" data-prompt="Is the kitchen busy right now?" role="listitem">Kitchen busy?</button>
      </div>

      <form class="cashier-form" id="cashier-form" autocomplete="off">
        <label for="cashier-input" class="sr-only">Your message</label>
        <input
          id="cashier-input"
          name="message"
          type="text"
          class="cashier-input"
          placeholder="What cake are you in the mood for?"
          maxlength="500"
          required
        />
        <button type="submit" class="cashier-send" id="cashier-send">Ask</button>
      </form>

      <!-- Manual-browse links + clear-conversation button. The clear
           button only shows when the transcript has at least one row;
           cashier-chat.js toggles its hidden attribute. -->
      <div class="cashier-card__footer">
        <div class="cashier-quicklinks">
          <span class="cashier-quicklinks__label">Or browse:</span>
          <a class="cashier-quicklink" href="/menu">Menu</a>
          <a class="cashier-quicklink" href="/order">Order</a>
          <a class="cashier-quicklink" href="/custom">Custom</a>
          <a class="cashier-quicklink" href="/policies">Policies</a>
        </div>
        <button
          type="button"
          class="cashier-clear"
          id="cashier-clear"
          hidden
          aria-label="Clear conversation"
        >
          Clear chat
        </button>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* is:global — the chat transcript rows are created at runtime by
     /cashier-chat.js (an external script). Astro's default scoped
     CSS adds a build-time [data-astro-cid-…] attribute to every
     selector AND to every element it renders, but DOM nodes created
     by external JS don't inherit that attribute, so the scoped rules
     never match runtime-built bubbles. is:global drops the attribute
     selector so the rules match runtime-created `.cashier-row--user`
     and `.cashier-row--assistant` elements as expected. The class
     names below are sufficiently namespaced (`cashier-*`) that
     bleeding outside this component is not a concern. */
  .cashier-hero {
    position: relative;
    overflow: hidden;
    color: var(--cream-50, #FBF6E8);
  }
  .cashier-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .cashier-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(14, 42, 60, 0.72) 0%,
      rgba(14, 42, 60, 0.55) 50%,
      rgba(14, 42, 60, 0.78) 100%
    );
    z-index: 1;
  }
  .cashier-hero__inner {
    position: relative;
    z-index: 2;
    max-width: 760px;
    margin: 0 auto;
    padding: 4rem 1.25rem 3rem;
    text-align: center;
  }
  .cashier-hero__eyebrow {
    font-family: "Inter", sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #BFD8E8;
    margin-bottom: 1rem;
  }
  .cashier-hero__headline {
    font-family: "Cormorant Garamond", "Cormorant", Georgia, serif;
    font-size: clamp(2.25rem, 4vw + 1rem, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
    color: #FBF6E8;
    margin: 0 0 0.85rem;
  }
  .cashier-hero__subhead {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    line-height: 1.55;
    color: #BFD8E8;
    max-width: 540px;
    margin: 0 auto 1.5rem;
  }

  .cashier-figure {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    margin: 0 auto 1.25rem;
    transition: transform 200ms ease;
  }
  .cashier-figure svg {
    background: rgba(251, 246, 232, 0.85);
    border-radius: 50%;
    padding: 6px;
  }
  .cashier-figure .cashier-think { display: none; }
  .cashier-figure[data-state="thinking"] .cashier-think { display: block; }
  .cashier-figure[data-state="thinking"] svg {
    background: #BFD8E8;
  }
  .cashier-figure[data-state="serving"] svg {
    background: #6E9D74;
  }
  .cashier-figure[data-state="serving"] .cashier-mouth {
    d: path("M53 60 Q60 68 67 60");
  }
  .cashier-figure[data-state="apologizing"] svg {
    background: #E08066;
  }
  .cashier-figure[data-state="apologizing"] .cashier-mouth {
    d: path("M55 64 Q60 60 65 64");
  }
  .cashier-caption {
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #BFD8E8;
  }

  .cashier-card {
    background: #FBF6E8;
    color: #1A1816;
    border: 0.5px solid rgba(14, 42, 60, 0.18);
    padding: 1rem 1rem 0.85rem;
    text-align: left;
    box-shadow: 0 8px 28px rgba(14, 42, 60, 0.18);
  }
  .cashier-card__transcript {
    max-height: 0;
    overflow-y: auto;
    transition: max-height 280ms ease;
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .cashier-card__transcript.has-messages {
    max-height: 480px;
    margin-bottom: 0.85rem;
    padding: 0.85rem 0.25rem;
  }
  .cashier-card__transcript .cashier-row {
    display: flex;
    margin: 0 0 1.2rem;
    animation: cashier-fade 180ms ease both;
  }
  @keyframes cashier-fade {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .cashier-bubble-wrap {
    max-width: 82%;
    display: flex;
    flex-direction: column;
  }
  .cashier-row--user { justify-content: flex-end; }
  .cashier-row--user .cashier-bubble-wrap { align-items: flex-end; }
  .cashier-row--assistant { justify-content: flex-start; }
  .cashier-bubble-label {
    font-family: "Inter", sans-serif;
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-bottom: 0.25rem;
    opacity: 0.7;
  }
  .cashier-row--user .cashier-bubble-label {
    color: #1B4868;
  }
  .cashier-row--assistant .cashier-bubble-label {
    color: #6E9D74;
  }
  .cashier-bubble {
    padding: 0.75rem 1rem;
    line-height: 1.55;
    word-wrap: break-word;
    box-shadow: 0 1px 2px rgba(14, 42, 60, 0.08);
  }
  .cashier-row--user .cashier-bubble {
    background: #0E2A3C;
    color: #FBF6E8;
    border-radius: 14px 14px 4px 14px;
  }
  .cashier-row--assistant .cashier-bubble {
    background: #F4ECD3;
    color: #1A1816;
    border-radius: 14px 14px 14px 4px;
    border-left: 3px solid #6E9D74;
  }
  .cashier-row--error .cashier-bubble {
    background: #E08066;
    color: #FBF6E8;
    border-radius: 14px;
  }
  .cashier-row--typing .cashier-bubble {
    font-style: italic;
    opacity: 0.7;
    background: transparent;
    padding-left: 0.2rem;
    box-shadow: none;
  }
  .cashier-row--typing .cashier-bubble::after {
    content: "…";
    display: inline-block;
    margin-left: 0.2rem;
    animation: cashier-dots 1s steps(4, end) infinite;
  }
  @keyframes cashier-dots {
    0% { content: ""; }
    25% { content: "."; }
    50% { content: ".."; }
    75%, 100% { content: "..."; }
  }
  /* Markdown content inside assistant bubbles. */
  .cashier-bubble p { margin: 0 0 0.4em; }
  .cashier-bubble p:last-child { margin-bottom: 0; }
  .cashier-bubble ul {
    margin: 0.3em 0 0.3em 1.1em;
    padding: 0;
    list-style: disc;
  }
  .cashier-bubble li { margin: 0.1em 0; }
  .cashier-bubble strong { font-weight: 600; }
  .cashier-bubble em { font-style: italic; }
  .cashier-bubble code {
    background: rgba(14, 42, 60, 0.08);
    padding: 0 0.25em;
    font-size: 0.92em;
  }

  .cashier-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.65rem;
  }
  .cashier-chip {
    font-family: "Inter", sans-serif;
    font-size: 0.85rem;
    background: transparent;
    border: 0.5px solid rgba(14, 42, 60, 0.4);
    color: #1B4868;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .cashier-chip:hover,
  .cashier-chip:focus {
    background: #1B4868;
    color: #FBF6E8;
    outline: none;
  }

  .cashier-form {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }
  .cashier-input {
    flex: 1 1 auto;
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    padding: 0.65rem 0.85rem;
    border: 0.5px solid rgba(14, 42, 60, 0.4);
    background: #FFFFFF;
    color: #1A1816;
    min-width: 0;
  }
  .cashier-input:focus {
    border-color: #1B4868;
    outline: 2px solid #3B7BA8;
    outline-offset: -2px;
  }
  .cashier-send {
    font-family: "Inter", sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    background: #1B4868;
    color: #FBF6E8;
    border: none;
    padding: 0 1.4rem;
    cursor: pointer;
    transition: background 0.15s;
  }
  .cashier-send:hover,
  .cashier-send:focus {
    background: #0E2A3C;
    outline: none;
  }
  .cashier-send:disabled {
    background: #3B7BA8;
    cursor: not-allowed;
  }

  /* Footer row — quick links left, clear-chat button right. */
  .cashier-card__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem 0.6rem;
    margin-top: 0.4rem;
    border-top: 0.5px solid rgba(14, 42, 60, 0.15);
    font-family: Inter, system-ui, sans-serif;
    font-size: 0.75rem;
  }
  .cashier-quicklinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    align-items: baseline;
    color: rgba(26, 24, 22, 0.7);
  }
  .cashier-quicklinks__label {
    font-weight: 500;
    color: rgba(26, 24, 22, 0.55);
  }
  .cashier-quicklink {
    color: #1B4868;
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px dotted rgba(27, 72, 104, 0.4);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }
  .cashier-quicklink:hover,
  .cashier-quicklink:focus {
    color: #0E2A3C;
    border-bottom-color: #0E2A3C;
    outline: none;
  }
  .cashier-clear {
    background: transparent;
    border: 1px solid rgba(14, 42, 60, 0.25);
    color: rgba(26, 24, 22, 0.65);
    font: inherit;
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    cursor: pointer;
    border-radius: 4px;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .cashier-clear:hover,
  .cashier-clear:focus {
    background: rgba(224, 128, 102, 0.08);
    color: #0E2A3C;
    border-color: rgba(14, 42, 60, 0.5);
    outline: none;
  }
  .cashier-clear[hidden] {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 768px) {
    .cashier-hero__inner {
      padding: 5.5rem 1.5rem 4rem;
    }
  }
</style>

<div id="cashier-chat-config" data-api-base={apiBase} hidden></div>
<script src="/cashier-chat.js" is:inline></script>
