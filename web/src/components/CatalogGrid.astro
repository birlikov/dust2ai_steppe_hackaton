---
/**
 * CatalogGrid — full responsive product grid for /menu.
 *
 * Reads from `/api/catalog` at build time (falls back to whatever the
 * fetchCatalog helper returns). Each card has Add-to-cart wired to a
 * `hc_cart` localStorage list; the badge in BaseLayout listens for the
 * `hc-cart-changed` event.
 */
import { fetchCatalog } from "../lib/api";
import type { Product } from "../lib/api";

const catalog = await fetchCatalog();
const products: Product[] = catalog?.products ?? [];
const overCapacity = catalog?.kitchen?.overCapacity ?? false;
---

<section class="max-w-5xl mx-auto px-4 py-12">
  <div class="flex flex-wrap items-end justify-between gap-3 mb-8">
    <div>
      <p class="cake-name-label text-happy-blue-500 mb-1">◆ Today's bake</p>
      <h2 class="font-display text-3xl font-semibold text-happy-blue-900">
        Our cakes
      </h2>
      <p class="text-text-primary text-sm leading-relaxed mt-1 max-w-md">
        Time-tested recipes, hand-decorated and hand-packed.
      </p>
    </div>
    {overCapacity && (
      <p class="text-xs text-text-primary font-body bg-cream-200 card-border px-3 py-2">
        Kitchen is at capacity today. Orders shift to tomorrow.
      </p>
    )}
  </div>

  {products.length === 0 ? (
    <div class="card-border bg-cream-100 p-8 text-center">
      <p class="font-display text-2xl text-happy-blue-700 mb-2">
        We&rsquo;re updating the menu.
      </p>
      <p class="text-sm text-text-primary">
        Please check back in a moment, or
        <a href="https://wa.me/12815550100" rel="noopener noreferrer" target="_blank">
          send us a WhatsApp message
        </a>.
      </p>
    </div>
  ) : (
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 list-none m-0 p-0">
      {products.map((product) => (
        <li class="card-border bg-cream-100 flex flex-col">
          <a href={`/cake/${product.slug}`} class="no-underline">
            <img
              src={product.image.replace("/assets/brand", "/brand")}
              alt={product.name}
              width="400"
              height="280"
              class="w-full h-44 object-cover"
              loading="lazy"
            />
          </a>
          <div class="p-5 flex flex-col flex-1">
            <p class="cake-name-label text-happy-blue-700 mb-1">{product.category}</p>
            <h3 class="font-display text-lg font-semibold text-happy-blue-900 mb-2 leading-snug">
              <a href={`/cake/${product.slug}`} class="text-happy-blue-900 hover:text-happy-blue-700 no-underline">
                {product.name}
              </a>
            </h3>
            <p class="text-sm text-text-primary mb-3 leading-relaxed flex-1">
              {product.description}
            </p>
            <p class="font-body font-medium text-sm text-happy-blue-900 mb-4">
              {product.weightLabel ? `${product.weightLabel}, ` : ""}{product.priceFormatted}
            </p>
            <button
              type="button"
              class="add-to-cart btn-primary w-full"
              data-slug={product.slug}
              data-name={product.name}
              data-price={product.priceUsd}
              data-image={product.image.replace("/assets/brand", "/brand")}
            >
              Add to cart
            </button>
          </div>
        </li>
      ))}
    </ul>
  )}
</section>

<script is:inline>
  (function () {
    "use strict";
    var STORAGE_KEY = "hc_cart";

    function readCart() {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) { return []; }
    }

    function writeCart(cart) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent("hc-cart-changed"));
    }

    function addToCart(slug, name, price, image) {
      var cart = readCart();
      var line = cart.find(function (l) { return l.slug === slug; });
      if (line) {
        line.quantity = (line.quantity || 0) + 1;
      } else {
        cart.push({ slug: slug, name: name, price: Number(price), image: image, quantity: 1 });
      }
      writeCart(cart);
    }

    document.addEventListener("click", function (event) {
      var target = event.target;
      if (!(target instanceof HTMLElement)) return;
      if (!target.classList.contains("add-to-cart")) return;
      event.preventDefault();
      var slug = target.dataset.slug;
      if (!slug) return;
      addToCart(
        slug,
        target.dataset.name || slug,
        target.dataset.price || "0",
        target.dataset.image || ""
      );
      var original = target.textContent;
      target.textContent = "Added ✓";
      target.disabled = true;
      setTimeout(function () {
        target.textContent = original;
        target.disabled = false;
      }, 900);
    });
  })();
</script>
