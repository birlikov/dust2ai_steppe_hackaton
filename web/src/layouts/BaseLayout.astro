---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  /**
   * When true, the floating chat-widget script is not injected. Set on
   * pages that already have an inline chat (e.g. the cashier hero on `/`).
   */
  hideFloatingChat?: boolean;
}

const {
  title,
  description = "Real cakes, made by hand in our Sugar Land, TX kitchen. Cake \"Honey\", cake \"Napoleon\", cake \"Milk Maiden\" and more. Order on the site or WhatsApp.",
  canonicalUrl = Astro.url.href,
  ogImage = "/brand/logo/happy-cake-logo-1024.png",
  hideFloatingChat = false,
} = Astro.props;

const fullTitle = title === "HappyCake" ? title : `${title} — HappyCake`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />

    <!-- Google Fonts: Cormorant Garamond (display) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/brand/logo/happy-cake-logo-1024.png" />

    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-cream-50 text-text-primary">
    <!-- Site header -->
    <header class="bg-happy-blue-900 text-text-on-blue">
      <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 no-underline hover:opacity-90 transition-opacity">
          <img
            src="/brand/logo/happy-cake-logo-1024.png"
            alt="HappyCake wordmark"
            width="36"
            height="36"
            class="rounded-sm"
          />
          <span class="font-display text-xl text-text-on-blue font-semibold tracking-wide">
            HappyCake
          </span>
        </a>
        <nav aria-label="Main navigation" class="flex items-center gap-6">
          <ul class="flex gap-5 list-none m-0 p-0 text-sm font-body font-medium">
            <li><a href="/" class="text-happy-blue-200 hover:text-cream-50 transition-colors no-underline">Cashier</a></li>
            <li><a href="/menu" class="text-happy-blue-200 hover:text-cream-50 transition-colors no-underline">Menu</a></li>
            <li><a href="/agent" class="text-happy-blue-200 hover:text-cream-50 transition-colors no-underline">For agents</a></li>
            <li><a href="/policies" class="text-happy-blue-200 hover:text-cream-50 transition-colors no-underline">Policies</a></li>
          </ul>
          <a
            href="/checkout"
            id="cart-icon"
            class="relative inline-flex items-center justify-center w-9 h-9 text-cream-50 hover:bg-happy-blue-700 transition-colors no-underline"
            aria-label="Cart"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path>
            </svg>
            <span
              id="cart-count"
              data-count="0"
              class="absolute -top-1 -right-1 min-w-4 h-4 px-1 text-[0.65rem] font-semibold rounded-full bg-accent-coral text-cream-50 flex items-center justify-center hidden"
            >0</span>
          </a>
        </nav>
      </div>
    </header>

    <!-- Page content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Site footer -->
    <footer class="bg-happy-blue-900 text-text-on-blue mt-16">
      <div class="max-w-5xl mx-auto px-4 py-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <!-- Brand column -->
          <div>
            <p class="font-display text-xl font-semibold mb-2">HappyCake</p>
            <p class="text-happy-blue-200 text-sm leading-relaxed">
              The original taste of happiness.<br />
              350 Promenade Way<br />
              Sugar Land, TX 77478<br />
              <a href="tel:+12819798320" class="text-happy-blue-200 hover:text-cream-50 no-underline">(281) 979-8320</a>
            </p>
          </div>

          <!-- Links column -->
          <div>
            <p class="font-body font-medium text-sm uppercase tracking-wider text-happy-blue-200 mb-3">Pages</p>
            <ul class="space-y-2 text-sm list-none p-0 m-0">
              <li><a href="/" class="text-happy-blue-200 hover:text-cream-50 no-underline">Cashier</a></li>
              <li><a href="/menu" class="text-happy-blue-200 hover:text-cream-50 no-underline">Menu</a></li>
              <li><a href="/about" class="text-happy-blue-200 hover:text-cream-50 no-underline">About</a></li>
              <li><a href="/policies" class="text-happy-blue-200 hover:text-cream-50 no-underline">Policies</a></li>
              <li><a href="/custom" class="text-happy-blue-200 hover:text-cream-50 no-underline">Custom cake</a></li>
              <li><a href="/agent" class="text-happy-blue-200 hover:text-cream-50 no-underline">For agents</a></li>
              <li><a href="/privacy" class="text-happy-blue-200 hover:text-cream-50 no-underline">Privacy</a></li>
            </ul>
          </div>

          <!-- Contact column -->
          <div>
            <p class="font-body font-medium text-sm uppercase tracking-wider text-happy-blue-200 mb-3">Reach us</p>
            <ul class="space-y-2 text-sm list-none p-0 m-0">
              <li>
                <a
                  href="https://wa.me/12819798320"
                  class="text-happy-blue-200 hover:text-cream-50 no-underline"
                  rel="noopener noreferrer"
                  target="_blank"
                >WhatsApp</a>
              </li>
              <li>
                <a
                  href="https://instagram.com/happycake.us"
                  class="text-happy-blue-200 hover:text-cream-50 no-underline"
                  rel="noopener noreferrer"
                  target="_blank"
                >@happycake.us</a>
              </li>
              <li>
                <a
                  href="https://happycake.us"
                  class="text-happy-blue-200 hover:text-cream-50 no-underline"
                >happycake.us</a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Closing pattern — required on every page footer (brand.r8) -->
        <div class="border-t border-happy-blue-700 pt-6">
          <p class="text-sm text-happy-blue-200 closing-pattern">
            Order on the site at happycake.us or send a message on WhatsApp.
          </p>
          <p class="text-xs text-happy-blue-700 mt-3">
            &copy; {new Date().getFullYear()} HappyCake US. Sugar Land, TX.
          </p>
        </div>
      </div>
    </footer>

    <!-- Cart count syncs from localStorage on every page -->
    <script is:inline>
      (function() {
        function refreshCart() {
          try {
            var raw = localStorage.getItem('hc_cart');
            var cart = raw ? JSON.parse(raw) : [];
            var count = cart.reduce(function(sum, line) { return sum + (line.quantity || 0); }, 0);
            var badge = document.getElementById('cart-count');
            if (!badge) return;
            badge.textContent = String(count);
            if (count > 0) badge.classList.remove('hidden');
            else badge.classList.add('hidden');
          } catch (err) { /* ignore */ }
        }
        document.addEventListener('DOMContentLoaded', refreshCart);
        window.addEventListener('storage', refreshCart);
        window.addEventListener('hc-cart-changed', refreshCart);
      })();
    </script>

    {!hideFloatingChat && (
      <>
        <!-- Floating chat widget on inner pages. Hidden on `/` because the
             cashier hero there is the primary chat surface. -->
        <div id="chat-widget-root"></div>
        <script
          src="/chat-widget.js"
          data-api={import.meta.env.PUBLIC_API_BASE ?? ""}
          defer
        ></script>
      </>
    )}
  </body>
</html>
