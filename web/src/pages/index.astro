---
import BaseLayout from "../layouts/BaseLayout.astro";
import CashierChat from "../components/CashierChat.astro";
import SpecialtiesStrip from "../components/SpecialtiesStrip.astro";
import { fetchCatalog } from "../lib/api";
import type { KitchenState } from "../lib/api";

// Build-time fetch only used for the optional "today's bake" capacity
// banner. Product cards are rendered client-side by SpecialtiesStrip
// (always live against /api/catalog).
const catalogData = await fetchCatalog();
const kitchen: KitchenState | null = catalogData?.kitchen ?? null;
---

<BaseLayout
  title="HappyCake — The original taste of happiness"
  description="Real cakes, made by hand in our Sugar Land kitchen. Order online or on WhatsApp."
  hideFloatingChat
>
  <!-- Cashier hero — talk to the HappyCake cashier directly -->
  <CashierChat />
  <div class="awning-pattern h-5 w-full opacity-60"></div>

  <!-- Specialties — three on-the-counter cakes, deep-linked to /cake/[slug] -->
  <SpecialtiesStrip />

  <!-- Brand story strip -->
  <section class="bg-happy-blue-900 text-text-on-blue py-14">
    <div class="max-w-5xl mx-auto px-4 grid md:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-happy-blue-200 text-sm font-medium uppercase tracking-widest mb-3">◆ Our story</p>
        <h2 class="font-display text-3xl font-semibold text-cream-50 mb-4 leading-snug">
          &ldquo;It&rsquo;s just like homemade.&rdquo;
        </h2>
        <p class="text-happy-blue-200 text-base leading-relaxed mb-3">
          We started baking cakes the way you would for someone you love. Every
          ingredient is chosen by hand. Every recipe was perfected over years
          until it earned its name.
        </p>
        <p class="text-happy-blue-200 text-base leading-relaxed mb-5">
          When you choose our cake for a moment that matters, our hearts cheer
          and sink at once. That mix of pride and responsibility is what keeps
          us improving, day after day.
        </p>
        <a href="/about" class="btn-secondary border-happy-blue-200 text-happy-blue-200 hover:bg-happy-blue-700">
          Read more
        </a>
      </div>
      <div class="hidden md:block">
        <img
          src="/brand/hero/happy-cake-hero-02.webp"
          alt="Behind the counter at HappyCake Sugar Land"
          width="480"
          height="360"
          class="w-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Hours + location strip -->
  <section class="bg-cream-100 border-t border-b border-[rgba(14,42,60,0.12)]">
    <div class="max-w-5xl mx-auto px-4 py-4 flex flex-wrap items-center justify-between gap-3 text-sm">
      <p class="text-text-primary">
        <span class="font-medium">Mon-Fri 9-18</span>
        <span class="opacity-50">·</span>
        <span class="font-medium">Sat 10-14</span>
        <span class="opacity-50">·</span>
        <span class="opacity-70">Closed Sun</span>
      </p>
      <p class="text-text-primary">
        <span class="opacity-70">350 Promenade Way · Sugar Land, TX</span>
        <span class="opacity-50 mx-2">·</span>
        <a href="tel:+12819798320" class="text-happy-blue-500 hover:text-happy-blue-700">(281) 979-8320</a>
      </p>
    </div>
  </section>

  <!-- Today's bake notice -->
  {kitchen && !kitchen.overCapacity && (
    <section class="bg-cream-100 border-b border-[rgba(14,42,60,0.12)]">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center gap-3">
        <span class="text-happy-blue-700 font-body font-medium text-sm">Today&rsquo;s bake is out.</span>
        <span class="text-text-primary text-sm">
          {kitchen.remainingCapacityMinutes} min of kitchen capacity remaining — order now to secure yours.
        </span>
        <a href="/order" class="ml-auto text-sm font-medium text-happy-blue-500 hover:text-happy-blue-700 whitespace-nowrap">
          Order &rarr;
        </a>
      </div>
    </section>
  )}
  {kitchen?.overCapacity && (
    <section class="bg-cream-200 border-b border-[rgba(14,42,60,0.12)]">
      <div class="max-w-5xl mx-auto px-4 py-3">
        <span class="text-text-primary font-body text-sm">
          The kitchen is at capacity today. <a href="/order" class="font-medium">Order for tomorrow</a> — we&rsquo;ll confirm within the hour.
        </span>
      </div>
    </section>
  )}

  {/* Featured "Our cakes" section removed: SpecialtiesStrip above
      ("On the counter today") covers the same job, fetches client-side
      from the live MCP, and doesn't suffer from the build-time fetch
      gap. Duplicate "Our story" strip also removed (the one near the
      top covers it). The second pair was an iteration leftover. */}

  <!-- Content callouts: link to /about and /custom -->
  <section class="max-w-5xl mx-auto px-4 py-16 grid md:grid-cols-2 gap-8">
    <div class="card-border bg-cream-100 p-8">
      <p class="text-happy-blue-200 cake-name-label text-happy-blue-500 mb-2">Custom cakes</p>
      <h2 class="font-display text-2xl font-semibold text-happy-blue-900 mb-3">Have something specific in mind?</h2>
      <p class="text-sm text-text-primary leading-relaxed mb-6">
        Decoration is a small, optional service on top of our ready-made line. Tell us what you need and Saule and the team will reply within the hour.
      </p>
      <a href="/custom" class="btn-primary">Enquire about a custom cake</a>
    </div>

    <div class="card-border bg-cream-100 p-8">
      <p class="cake-name-label text-happy-blue-500 mb-2">Guides</p>
      <h2 class="font-display text-2xl font-semibold text-happy-blue-900 mb-3">Choosing a cake for your event</h2>
      <p class="text-sm text-text-primary leading-relaxed mb-6">
        Not sure how much cake to order, or which one suits the occasion? Our short guide covers guest count, dietary needs, and lead times.
      </p>
      <a href="/guides/cake-for-x-guests" class="btn-secondary">Read the guide</a>
    </div>
  </section>

  <!-- Closing pattern (brand.r8) -->
  <section class="bg-cream-100 border-t border-[rgba(14,42,60,0.12)] py-8">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <p class="text-text-primary text-sm">
        Order on the site at happycake.us or send a message on WhatsApp.
      </p>
    </div>
  </section>
</BaseLayout>
