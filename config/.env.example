# Copy to .env at the repo root; never commit the real .env.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Runtime LLM (`claude -p` subprocess) ---
# The bridge passes ANTHROPIC_MODEL to the `claude -p` child process. Pinned
# to Opus 4.7 per the hackathon brief. Override only for local experiments.
ANTHROPIC_MODEL=claude-opus-4-7

# --- Steppe Business Club hackathon MCP ---
SBC_MCP_URL=https://www.steppebusinessclub.com/api/mcp
SBC_TEAM_TOKEN=sbc_team_REPLACE_WITH_YOURS

# --- WhatsApp / Instagram webhooks (Meta) ---
META_VERIFY_TOKEN=
META_APP_SECRET=

# --- MCP ---
# Organizer-hosted servers go in config/mcp.json; this points the loader at it.
MCP_CONFIG_PATH=config/mcp.json

# --- Public URL (ngrok) ---
# Set by scripts/start_tunnel.sh once ngrok is up. Optionally pin a static
# domain (paid feature) so the URL doesn't change between restarts.
PUBLIC_URL=
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# --- Owner Telegram chat id (captured on first /start; fallback for the
#     proactive notifier when owner_identity hasn't been written yet) ---
OWNER_CHAT_ID=

# --- Owner-bot proactive notifier ---
# How often (seconds) the bot diffs MCP state and pushes a brief if anything
# material changed. Idle ticks stay silent. Default 1800 (30 min).
NOTIFIER_INTERVAL_S=1800

# --- Always-on world poller (sandbox listener) ---
# When the bot process boots it can spawn a long-lived WorldPoller that
# continuously drains `world_next_event` and routes each inbound through
# the customer-facing orchestrator (so simulator-emitted WhatsApp /
# Instagram messages get replied to without manual intervention).
# Set to `false` if you plan to run scripts/run_scenario.py against the
# same team token (two consumers race on the same timeline).
# `./scripts/run.sh --no-poller` overrides this for a single run.
WORLD_POLLER_ENABLED=true

# --- Kitchen-staff auto-loop (demo) ---
# When `true`, the bot process spawns a long-lived KitchenRunner that
# auto-accepts pending kitchen tickets (rejects when capacity gets
# tight) and marks them ready once their nominal lead time has
# elapsed — so judges see the full order → ticket → accept → ready
# loop close in real time without a separate kitchen UI.
# Off by default. Pair with WORLD_POLLER_ENABLED=true for the most
# end-to-end-feeling demo.
KITCHEN_AUTO_DEMO=false
KITCHEN_TICK_S=20
KITCHEN_REJECT_THRESHOLD_MIN=30

# --- Owner passphrase ---
# If set, the bot only responds to chats already paired with the owner OR
# to a chat that sends this exact passphrase (which then pairs that chat).
# Empty (the default) → open mode for dev / fresh clone.
# Pick something hard to guess. Example below is a placeholder; never commit
# a real value (the .env file is gitignored).
OWNER_PASSPHRASE=

# --- Storage ---
SQLITE_PATH=data/state.db

# --- Logging ---
LOG_LEVEL=INFO
