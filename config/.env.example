# Copy to .env at the repo root; never commit the real .env.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Anthropic (bot's runtime LLM access) ---
# OPTIONAL: not used for the hackathon runtime (we shell out to `claude -p`,
# which uses the user's Claude Max subscription). Kept for tests / one-offs.
ANTHROPIC_API_KEY=

# --- Steppe Business Club hackathon MCP ---
SBC_MCP_URL=https://www.steppebusinessclub.com/api/mcp
SBC_TEAM_TOKEN=sbc_team_REPLACE_WITH_YOURS

# --- WhatsApp / Instagram webhooks (Meta) ---
META_VERIFY_TOKEN=
META_APP_SECRET=

# --- MCP ---
# Organizer-hosted servers go in config/mcp.json; this points the loader at it.
MCP_CONFIG_PATH=config/mcp.json

# --- Public URL (ngrok) ---
# Set by scripts/start_tunnel.sh once ngrok is up. Optionally pin a static
# domain (paid feature) so the URL doesn't change between restarts.
PUBLIC_URL=
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# --- Storage ---
SQLITE_PATH=data/state.db

# --- Logging ---
LOG_LEVEL=INFO
